generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id              String   @id @default(cuid())
  fullName        String
  age             Int?
  relationship    String?
  phoneNumber     String?
  notes           String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  medicines       Medicine[]
  doseEvents      DoseEvent[]

  @@index([createdByUserId])
}

model Medicine {
  id              String           @id @default(cuid())
  patientId       String
  name            String
  dosage          String?
  form            String?
  frequency       String?
  foodInstruction String?
  instructions    String?
  status          String           @default("ACTIVE")
  startDate       DateTime
  endDate         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  timings         MedicineTiming[]
  doseEvents      DoseEvent[]

  @@index([patientId])
  @@index([createdAt])
}

model MedicineTiming {
  id         String   @id @default(cuid())
  medicineId String
  label      String?
  timeOfDay  String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  doseEvents DoseEvent[]

  @@index([medicineId])
}

model DoseEvent {
  id                      String   @id @default(cuid())
  patientId               String
  medicineId              String
  medicineTimingId        String
  scheduledAt             DateTime
  status                  String   @default("PENDING")
  medicineNameSnapshot    String
  dosageSnapshot          String?
  foodInstructionSnapshot String?
  instructionsSnapshot    String?
  timingLabelSnapshot     String?
  timingTimeSnapshot      String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicine       Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  medicineTiming MedicineTiming @relation(fields: [medicineTimingId], references: [id], onDelete: Cascade)

  @@unique([medicineId, medicineTimingId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([patientId, status])
}
